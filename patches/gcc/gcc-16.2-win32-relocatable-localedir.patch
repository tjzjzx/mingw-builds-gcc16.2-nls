+/* Minimal Win32 declarations: including <windows.h> here would pull in
+   macros that clash with GCC's own headers.  */
+extern "C" __declspec(dllimport) unsigned long __stdcall
+  GetModuleFileNameA (void *, char *, unsigned long);
+extern "C" __declspec(dllimport) unsigned long __stdcall
+  GetFileAttributesA (const char *);
+
+#define WIN32_FILE_ATTRIBUTE_DIRECTORY 0x10ul
+
+/* Return the locale directory of the running executable
+   (<prefix>/share/locale), or NULL if it cannot be determined.  It is
+   looked up relative to the executable so that the compiled-in
+   LOCALEDIR is only a fallback and the toolchain stays relocatable.  */
+
+static const char *
+win32_relocatable_localedir (void)
+{
+  static char localedir[4096];
+  static int initialized = 0;
+
+  if (initialized)
+    return localedir[0] != '\0' ? localedir : NULL;
+  initialized = 1;
+
+  char exe[4096];
+  unsigned long len = GetModuleFileNameA (NULL, exe, sizeof (exe));
+
+  if (len == 0 || len >= sizeof (exe))
+    return NULL;
+
+  char *slash = strrchr (exe, '\\');
+  if (slash == NULL)
+    return NULL;
+  *slash = '\0';
+
+  for (int depth = 0; depth < 6; ++depth)
+    {
+      snprintf (localedir, sizeof (localedir), "%s/share/locale", exe);
+
+      unsigned long attr = GetFileAttributesA (localedir);
+      if (attr != (unsigned long) -1
+	  && (attr & WIN32_FILE_ATTRIBUTE_DIRECTORY) != 0)
+	return localedir;
+
+      slash = strrchr (exe, '\\');
+      if (slash == NULL || slash == exe)
+	break;
+      *slash = '\0';
+    }
+
+  localedir[0] = '\0';
+  return NULL;
+}
+
+#undef WIN32_FILE_ATTRIBUTE_DIRECTORY
+
+#endif /* _WIN32 && ENABLE_NLS */
